let jitusen = [0, 203.91, 701.96, 884.36, 1200, 1403.91, 1901.96, 2084.36, 2400, 2603.91]
    degToFreq :: Double -> Double
    degToFreq d = 49.00 * (2 ** ((jitusen !! round d) / 1200))

let strange = [0, 231.17, 498.04, 702.96, 968.83, 1200, 1431.17, 1698.04, 1902.96, 2168.83]
    degToFreq :: Double -> Double
    degToFreq d = 49.00 * (2 ** ((strange !! round d) / 1200))

    -- just intonation
d3 $ degradeBy 0.9 $ slow 1 $ freq (fmap degToFreq "1 1 1 1 1 2 2 2 2 8")
